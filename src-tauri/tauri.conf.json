{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postdim App",
  "version": "0.1.0",
  "identifier": "io.postdim.desktop",
  "build": {
    "frontendDist": "../www",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "title": "Postdim",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": "embeddedHtml"
    }
  }
}