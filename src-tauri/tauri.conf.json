{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Postdim",
  "version": "0.1.0",
  "identifier": "io.postdim.desktop",
  "build": {
    "frontendDist": "../www",
    "devUrl": null,
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Postdim",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "identifier": "io.postdim.desktop"
  },
  "permissions": [
    "core:default",
    {
      "identifier": "allow-http-request",
      "allow": [
        {
          "name": "http_request"
        }
      ]
    }
  ]
}