{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables default permissions and custom http_request command",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "allow": [
        {
          "name": "http_request"
        }
      ]
    }
  ]
}