{
  "identifier": "default",
  "description": "Enables the default permissions and http_request command",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "allow-http-request",
      "description": "Allows the http_request command",
      "allow": [
        {
          "name": "http_request"
        }
      ]
    }
  ]
}