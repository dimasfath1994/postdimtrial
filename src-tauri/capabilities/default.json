{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "allow-http-request",
      "allow": [
        {
          "name": "http_request"
        }
      ]
    }
  ]
}
