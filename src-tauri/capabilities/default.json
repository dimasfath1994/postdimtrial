{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "allow-http-request",
      "description": "Allow invoking the http_request command",
      "commands": {
        "allow": [
          "http_request"
        ]
      }
    }
  ]
}
