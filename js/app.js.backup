// ===== INIT AUTH STATE =====
function initAuthUI() {

  const token = Auth.token;

  if (!token) {
    userBar.style.display = "none";
    return;
  }

  userBar.style.display = "block";
  userEmail.textContent = "Logged in (collab mode)";
}
collabBtn.onclick = () => {

  if (!Auth.isLoggedIn()) {
    window.location.href = "/login.html";
    return;
  }

  if (CollabState.enabled) {
    console.log("Already in collab mode");
    return;
  }

  enableCollabMode();
};
logoutBtn.onclick = () => {

  Auth.clear?.();

  CollabState.enabled = false;

  logoutBtn.style.display = "none";

  collabBtn.textContent = "Collaboration Mode";

  window.location.href = "/login.html";
};
function safeSync() {
  if (!CollabState.enabled) return;
  if (!Auth.isLoggedIn()) return;
  if (isApplyingRemoteState) return;

  clearTimeout(syncTimer);

  syncTimer = setTimeout(() => {
    pushSync();
  }, 250);
}

async function initCollabFromAuth() {

  const token = Auth.token;

  if (!token) return;

  await enableCollabMode();
}
async function enableCollabMode() {

  if (CollabState.enabled) return;

  CollabState.enabled = true;

  const logoutBtn = document.getElementById("collabLogoutBtn");
  const collabBtn = document.getElementById("collabModeBtn");

  if (logoutBtn) {
    logoutBtn.style.display = "inline-block";
  }

  if (collabBtn) {
    collabBtn.textContent = "Collaboration Mode (ON)";
  }

  enableCollabModeUI();

  tabs.tabs = [];
  tabs.activeId = null;

  collections.clear?.();
  Environment.clear?.();

  await loadInitialWorkspace();
}
async function loadInitialWorkspace() {

  try {

    const list =
      await WorkspaceService.getMyWorkspaces();

    // belum punya workspace
    if (!list.length) {

      const ws =
        await WorkspaceService.createWorkspace(
          "My Workspace"
        );

      APP_STATE.workspaceId = ws.id;
      APP_STATE.workspace = ws;

      await loadWorkspace(ws.id);

      return;
    }

    // ambil workspace pertama
    const first = list[0];

    APP_STATE.workspaceId = first.id;

    await loadWorkspace(first.id);

  } catch (err) {
    console.error(err);
  }
}
async function loadWorkspace(id) {

  try {

    const ws =
      await WorkspaceService.getWorkspace(id);

    APP_STATE.workspace = ws;

    const data = ws.data || {};

    applyRemoteState(data);

    console.log("[Workspace Loaded]", ws.name);

  } catch (err) {
    console.error(err);
  }
}
function enableCollabModeUI() {
  document.body.classList.add("collab-mode");

  console.log("Collab mode enabled");
}

